{
  "name": "martine",
  "version": "4.8.4",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/dev-db.ts",
    "dev": "next dev --webpack",
    "predev:prod": "INIT_MODE=prod-datas tsx scripts/dev-db.ts",
    "dev:prod": "INIT_MODE=prod-datas next dev --webpack",
    "db:reset": "tsx scripts/dev-db.ts --reset",
    "db:stop": "container stop crf-dev-db || true",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "dev:setup": "tsx scripts/setup-dev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@libsql/client": "^0.5.6",
    "@opentelemetry/api": "^1.9.1",
    "@react-pdf/renderer": "^4.3.2",
    "@remscodes/renault-api": "^2.0.0",
    "@remscodes/renault-api-client": "^2.0.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.575.0",
    "matter-js": "^0.20.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-onesignal": "^3.5.1",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.20",
    "esbuild": "^0.28.1"
  }
