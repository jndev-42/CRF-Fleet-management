// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Vehicle {
  id          String   @id @default(cuid())
  name        String   // ex: "VL186"
  type        String   // ex: "VL", "VPSP"
  plate       String   @unique // immatriculation
  status      String   @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE
  parkingSpot String?  // emplacement de stationnement
  fuelLevel   Int      @default(100) // 0-100 %
  mileage     Int      @default(0) // km
  hasDSA      Boolean  @default(false) // véhicule équipé d'un DSA
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trips       Trip[]
}

model Trip {
  id           String    @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])

  // Infos chauffeur
  driverName   String    // nom du chauffeur
  driverEmail  String?   // email pour recevoir le rapport

  // Mission
  missionType  String    // DAPS, Maraude, Formation, Transport, Action sociale, Autre
  missionName  String?   // nom de la mission (si applicable)

  // --- CHECK-OUT (Prise du véhicule) ---
  checkOutAt   DateTime  @default(now())
  mileageOut   Int       // km au départ
  fuelOut      Int       // essence au départ (%)
  conditionOut String    // état au départ
  parkingOut   String?   // stationnement au départ
  dsaChecked   Boolean   @default(false) // DSA vérifié
  commentsOut  String?   // commentaires avant le poste

  // --- CHECK-IN (Retour du véhicule) ---
  checkInAt      DateTime? // date/heure de retour (null = en cours)
  mileageIn      Int?      // km au retour
  fuelIn         Int?      // essence au retour (%)
  conditionIn    String?   // état au retour
  parkingIn      String?   // stationnement au retour
  windowsClosed  Boolean?  // vitres fermées et radios éteintes
  vehicleInspected Boolean? // tour du véhicule effectué
  incident       String?   // incident sur véhicule
  dsaUsed        Boolean?  // DSA utilisé
  commentsIn     String?   // commentaires après le poste
  parkingPhoto   String?   // photo du véhicule garé (base64)

  createdAt    DateTime  @default(now())

  @@index([vehicleId])
}
